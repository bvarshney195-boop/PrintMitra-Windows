<Window x:Class="PrintMitra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintMitra — Offline Print Assistant" Height="820" Width="1180" MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#EEF3F6">
  <Grid Margin="18">
    <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
          <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrandBrush}"><TextBlock Text="P" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel Margin="11,2,0,0"><TextBlock Text="PrintMitra" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Offline Windows Print Assistant" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
              <ComboBox x:Name="ModeCombo" Width="120" SelectionChanged="ModeCombo_SelectionChanged"><ComboBoxItem IsSelected="True">Easy</ComboBoxItem><ComboBoxItem>Operator</ComboBoxItem></ComboBox>
            </StackPanel>
          </DockPanel>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12">
            <StackPanel>
              <Button Content="Home" Click="ShowHome_Click" HorizontalContentAlignment="Left"/>
              <Button Content="Aadhaar / PAN" Click="ShowCard_Click" HorizontalContentAlignment="Left"/>
              <Button Content="A4 Preview" Click="ShowPreview_Click" HorizontalContentAlignment="Left"/>
              <Button Content="Calibration" Click="ShowCalibration_Click" HorizontalContentAlignment="Left"/>
              <Separator Margin="5,14"/>
              <TextBlock Text="100% offline" Foreground="#16794B" Margin="8"/>
              <TextBlock Text="No cloud upload. Sensitive temporary files are deleted when the app closes." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="8"/>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1" Margin="28">
            <Grid x:Name="HomePanel">
              <StackPanel>
                <TextBlock Text="What would you like to print?" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a task. PrintMitra prepares the page before opening Windows printing." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
                <UniformGrid Columns="3" Rows="2">
                  <Button Height="120" Content="Print Photos" Click="ShowPhotos_Click"/>
                  <Button Height="120" Content="Print Documents" Click="ShowDocuments_Click"/>
                  <Button Height="120" Content="Print Aadhaar / PAN" Click="ShowCard_Click"/>
                  <Button Height="120" Content="Passport / ID Photos" Click="ShowPassport_Click"/>
                  <Button Height="120" Content="Scan and Print" Click="ShowScan_Click"/>
                  <Button x:Name="ReprintHomeButton" Height="120" Content="Print Again" Click="PrintAgain_Click" IsEnabled="False"/>
                </UniformGrid>
              </StackPanel>
            </Grid>

            <Grid x:Name="PhotosPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Print photos" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Select one or more photographs and arrange them automatically on the selected paper." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,18,0"><ListBox x:Name="PhotoFilesList"/></Border>
                <StackPanel Grid.Column="1">
                  <Button Content="Choose photographs" Click="ChoosePhotos_Click"/>
                  <TextBlock Text="Images per row" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox x:Name="PhotoColumnsCombo"><ComboBoxItem>1</ComboBoxItem><ComboBoxItem IsSelected="True">2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem></ComboBox>
                  <TextBlock Text="Crop behaviour" FontWeight="SemiBold"/><ComboBox x:Name="PhotoCropCombo"><ComboBoxItem IsSelected="True">Show complete image</ComboBoxItem><ComboBoxItem>Fill each space</ComboBoxItem></ComboBox>
                  <TextBlock Text="Paper" FontWeight="SemiBold"/><ComboBox x:Name="PhotoPaperCombo" DisplayMemberPath="Name"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Create preview" Background="{StaticResource BrandBrush}" Foreground="White" Click="PreviewPhotos_Click"/></StackPanel>
            </Grid>

            <Grid x:Name="DocumentsPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Print documents" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Import scanned or photographed pages. PDFs open in the installed Windows PDF application for printing." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,18,0"><ListBox x:Name="DocumentFilesList"/></Border>
                <StackPanel Grid.Column="1">
                  <Button Content="Choose document pages or PDF" Click="ChooseDocuments_Click"/>
                  <Button x:Name="OpenPdfButton" Content="Open selected PDF" Click="OpenPdf_Click" IsEnabled="False"/>
                  <TextBlock Text="Paper" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox x:Name="DocumentPaperCombo" DisplayMemberPath="Name"/>
                  <CheckBox x:Name="DocumentFitCheck" Content="Show complete page" IsChecked="True" Margin="0,8"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Create image-page preview" Background="{StaticResource BrandBrush}" Foreground="White" Click="PreviewDocuments_Click"/></StackPanel>
            </Grid>

            <Grid x:Name="PassportPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Passport / ID photos" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Create an exact-size photo sheet. Always verify the current authority requirements before submission." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,18,0"><Image x:Name="PassportImage" Stretch="Uniform"/></Border>
                <StackPanel Grid.Column="1">
                  <Button Content="Choose portrait photograph" Click="ChoosePassport_Click"/>
                  <TextBlock Text="Preset" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox x:Name="PassportPresetCombo" SelectionChanged="PassportPresetCombo_SelectionChanged"><ComboBoxItem IsSelected="True">35 × 45 mm</ComboBoxItem><ComboBoxItem>2 × 2 inch</ComboBoxItem><ComboBoxItem>Custom</ComboBoxItem></ComboBox>
                  <UniformGrid Columns="2"><StackPanel Margin="0,0,6,0"><TextBlock Text="Width (mm)"/><TextBox x:Name="PassportWidthBox" Text="35"/></StackPanel><StackPanel Margin="6,0,0,0"><TextBlock Text="Height (mm)"/><TextBox x:Name="PassportHeightBox" Text="45"/></StackPanel></UniformGrid>
                  <TextBlock Text="Copies"/><TextBox x:Name="PassportCopiesBox" Text="8"/>
                  <TextBlock Text="Paper"/><ComboBox x:Name="PassportPaperCombo" DisplayMemberPath="Name"/>
                  <CheckBox x:Name="PassportGuidesCheck" Content="Show cutting guides" IsChecked="True"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Create photo sheet" Background="{StaticResource BrandBrush}" Foreground="White" Click="PreviewPassport_Click"/></StackPanel>
            </Grid>

            <Grid x:Name="ScanPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Scan and print" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Uses the standard Windows scanner dialog for Canon G2000 and WIA-compatible imageCLASS devices." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,18,0"><Image x:Name="ScannedImage" Stretch="Uniform"/></Border>
                <StackPanel Grid.Column="1"><Button Content="Open Windows scanner" Click="AcquireScan_Click"/><TextBlock Text="Paper" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox x:Name="ScanPaperCombo" DisplayMemberPath="Name"/><CheckBox x:Name="ScanFitCheck" Content="Show complete scanned page" IsChecked="True" Margin="0,8"/><TextBlock Text="The official Canon scanner driver must be installed." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/></StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Create scan preview" Background="{StaticResource BrandBrush}" Foreground="White" Click="PreviewScan_Click"/></StackPanel>
            </Grid>

            <Grid x:Name="CardPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><TextBlock Text="Prepare Aadhaar or PAN card" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Choose front/back photographs. The software detects the four corners and corrects perspective locally." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Front" FontSize="18" FontWeight="SemiBold"/>
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Margin="0,10" CornerRadius="8"><Image x:Name="FrontImage" Stretch="Uniform"/></Border>
                    <Button Grid.Row="2" Content="Choose front photograph" Click="ChooseFront_Click"/>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Margin="8,0,0,0" Padding="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
                  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Back" FontSize="18" FontWeight="SemiBold"/>
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Margin="0,10" CornerRadius="8"><Image x:Name="BackImage" Stretch="Uniform"/></Border>
                    <Button Grid.Row="2" Content="Choose back photograph" Click="ChooseBack_Click"/>
                  </Grid>
                </Border>
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><TextBlock x:Name="CorrectionStatus" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/><Button Content="Correct images and preview" Background="{StaticResource BrandBrush}" Foreground="White" Click="CorrectAndPreview_Click"/></StackPanel>
            </Grid>

            <Grid x:Name="PreviewPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <StackPanel><TextBlock x:Name="PreviewTitle" Text="Print preview" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PreviewSubtitle" Text="Review every page before opening Windows printing." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel>
              <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>
                <Border Background="#DCE5EA" CornerRadius="10" Padding="18" Margin="0,0,18,0"><DocumentViewer x:Name="PreviewViewer"/></Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Printer" FontWeight="SemiBold"/><ComboBox x:Name="PrinterCombo" SelectionChanged="PrinterCombo_SelectionChanged"/>
                  <Button Content="Printer Properties" Click="PrinterProperties_Click"/>
                  <TextBlock Text="Paper" FontWeight="SemiBold" Margin="0,12,0,0"/><ComboBox x:Name="PaperCombo" DisplayMemberPath="Name" SelectionChanged="PaperCombo_SelectionChanged"/>
                  <TextBlock Text="Complete sets" FontWeight="SemiBold"/><TextBox x:Name="SetsBox" Text="1" PreviewTextInput="NumericOnly_PreviewTextInput" TextChanged="SetsBox_TextChanged"/>
                  <CheckBox x:Name="CutGuidesCheck" Content="Show cutting guides" IsChecked="True" Margin="0,8" Checked="PreviewOption_Changed" Unchecked="PreviewOption_Changed"/>
                  <Border x:Name="ExactSizeWarning" Background="#FFF6DE" CornerRadius="8" Padding="11" Margin="0,12" Visibility="Collapsed"><TextBlock Text="Exact-size safeguard: open Printer Properties and keep Fit to Page disabled." TextWrapping="Wrap" Foreground="#7A5200"/></Border>
                  <Button Content="Open Windows Print Dialog" Background="{StaticResource BrandBrush}" Foreground="White" Click="Print_Click"/>
                </StackPanel>
              </Grid>
            </Grid>

            <Grid x:Name="CalibrationPanel" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
              <DocumentViewer x:Name="CalibrationViewer" Margin="0,0,20,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Printer calibration" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Print the reference page, measure it with a ruler, then enter the measured values." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/>
                <TextBlock Text="100 mm line measured (mm)"/><TextBox x:Name="MeasuredXBox" Text="100.0"/>
                <TextBlock Text="50 mm box height measured (mm)"/><TextBox x:Name="MeasuredYBox" Text="50.0"/>
                <Button Content="Print calibration sheet" Click="PrintCalibration_Click"/>
                <Button Content="Save calibration" Background="{StaticResource BrandBrush}" Foreground="White" Click="SaveCalibration_Click"/>
                <TextBlock x:Name="CalibrationStatus" TextWrapping="Wrap" Margin="4,12" Foreground="#16794B"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
        <StatusBar Grid.Row="2" Background="{StaticResource PanelBrush}"><StatusBarItem><TextBlock x:Name="AppStatus" Text="Ready · Offline mode"/></StatusBarItem></StatusBar>
      </Grid>
    </Border>
  </Grid>
</Window>
